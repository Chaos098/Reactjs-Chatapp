elative="1" as="geometry"/></mxCell><mxCell id="e8" value="có các thành viên&#10;(conversation_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="conversations_r0" target="conversation_members_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="tạo ra&#10;(created_by)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#d79b00;fontColor=#d79b00;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="users_r0" target="conversations_r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="chứa tin nhắn&#10;(conversation_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#82b366;fontColor=#82b366;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="conversations_r0" target="messages_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="gửi tin nhắn&#10;(sender_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#b85450;fontColor=#b85450;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="users_r0" target="messages_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="diễn ra cuộc gọi&#10;(conversation_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#9673a6;fontColor=#9673a6;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="conversations_r0" target="calls_r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="thực hiện cuộc gọi&#10;(caller_id)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=11;fontStyle=1;strokeWidth=2;strokeColor=#6c8ebf;fontColor=#6c8ebf;labelBackgroundColor=#ffffff;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;" edge="1" parent="1" source="users_r0" target="calls_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b&gt;Chú giải&lt;/b&gt;&lt;br&gt;Mỗi đường nối đi từ &lt;b&gt;PK của bảng cha&lt;/b&gt; (phía 1) tới &lt;b&gt;cột FK (nền vàng)&lt;/b&gt; của bảng con (phía nhiều).&lt;br&gt;Nhãn = ý nghĩa quan hệ + tên cột FK.&lt;br&gt;Ký hiệu 1 gạch = bắt buộc; vòng tròn = có thể rỗng (nullable).&lt;br&gt;Màu bảng: xanh dương = tài khoản, cam = quan hệ xã hội &amp;amp; report, xanh lá = chat, tím = cuộc gọi." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;strokeColor=#999999;fillColor=#f5f5f5;spacing=8;" vertex="1" parent="1"><mxGeometry x="0" y="700" width="520" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>